PORT=3101
# Default bind is loopback. Put authentication in front before exposing to a network.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3101
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_SCOPE=openid profile email
OIDC_ALLOWED_SUBJECTS=
# Existing twitter-lite relay. Profiles are discovered automatically.
TWITTER_RELAY_BASE_URL=
# Docker Compose browser login password (user: kasm_user).
TWITTER_BROWSER_PASSWORD=
# Local encrypted account storage (defaults to .data).
FLARE_DATA_DIR=.data
