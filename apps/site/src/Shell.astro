---
import { clientPage } from "./links";
import { locales, localizedPath, translator, type Locale } from "./locales";
interface Props {
  title: string;
  locale: Locale;
  page?: string;
}
const { title, locale, page = "" } = Astro.props;
const t = translator(locale);
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hans" : locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Noren</title>
  </head>
  <body>
    <header>
      <a href={localizedPath(locale)} class="logo">
        Noren
      </a>
      <nav>
        <a href={localizedPath(locale, "plugins/")}>
          {t("作者ガイド", "Plugin guide", "插件指南")}
        </a>
        <a class="open-app" href={clientPage()}>
          {t("アプリを開く", "Open app", "打开应用")} ↗
        </a>
        <label>
          <span class="sr-only">Language / 言語 / 语言</span>
          <select data-language>
            {locales.map((l) => (
              <option value={localizedPath(l, page)} selected={l === locale}>
                {{ en: "English", ja: "日本語", zh: "简体中文" }[l]}
              </option>
            ))}
          </select>
        </label>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      document
        .querySelector<HTMLSelectElement>("[data-language]")
        ?.addEventListener("change", (event) => {
          location.href = (event.currentTarget as HTMLSelectElement).value;
        });
    </script>
  </body>
</html>
<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  header nav {
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: flex-end;
  }
  header select {
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    border: 1px solid #ccd1ca;
    border-radius: 1rem;
    background: white;
    padding: 0.25rem 0.5rem;
  }
  * {
    box-sizing: border-box;
  }
  body {
    background: #f7f5fc;
    color: #281c41;
    margin: 0;
    font:
      16px/1.75 system-ui,
      sans-serif;
  }
  header,
  main {
    max-width: 1100px;
    margin: auto;
    padding: 20px clamp(20px, 5vw, 72px);
  }
  header,
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  header {
    border-bottom: 1px solid #dcd6e6;
  }
  .logo {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.08em;
  }
  .logo span {
    font-size: 12px;
    letter-spacing: 0;
    margin-left: 7px;
  }
  a {
    color: inherit;
    text-underline-offset: 4px;
  }
  .logo,
  nav a {
    text-decoration: none;
  }
  h1 {
    font-size: clamp(40px, 7vw, 80px);
    letter-spacing: -0.055em;
    line-height: 1.17;
    margin: 30px 0 20px;
  }
  h2 {
    line-height: 1.4;
    margin-top: 32px;
  }
  .hero {
    padding: clamp(20px, 5vw, 64px) 0;
  }
  .cta,
  button {
    display: inline-block;
    background: #453068;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    text-decoration: none;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .panel {
    background: white;
    border: 1px solid #ddd6e6;
    border-radius: 18px;
    padding: clamp(16px, 3vw, 32px);
    margin: 24px 0;
  }
  pre,
  textarea {
    overflow: auto;
    background: #eeebf6;
    padding: 14px;
    border-radius: 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  textarea {
    width: 100%;
    font: inherit;
    border: 1px solid #c9bfd7;
  }
  p {
    max-width: 65ch;
  }
</style>
